+    // W ~= up @ down, stored as `<name>.down.weight` [rank, in] and `<name>.up.weight` [out, rank].
+    struct LowRankLinear : public UnaryBlock {
+        LowRankLinear(int64_t in_features,
+                      int64_t rank,
+                      int64_t out_features,
+                      bool force_prec_f32 = false,
+                      float scale         = 1.f) {
+            blocks["down"] = std::make_shared<Linear>(in_features, rank, false, false, force_prec_f32, scale);
+            blocks["up"]   = std::make_shared<Linear>(rank, out_features, false, false, force_prec_f32, scale);
+        }
+
+        std::shared_ptr<Linear> part(const char* name) {
+            return std::dynamic_pointer_cast<Linear>(blocks[name]);
+        }
+
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x) override {
+            return part("up")->forward(ctx, part("down")->forward(ctx, x));
+        }
+    };
+
+    // CUDA MMQ addresses its F32 output with 32-bit offsets, so one quantized matmul must stay below
+    // 2^31 output elements; full-length clips exceed that on the widest projections.
+    static int64_t max_matmul_tokens(int64_t out_features, const ggml_tensor* x) {
+        constexpr int64_t tile = 256;
+        int64_t per_token      = out_features * x->ne[2] * x->ne[3];
+        return std::max<int64_t>(tile, (static_cast<int64_t>(INT32_MAX) / per_token) / tile * tile - tile);
+    }
+
+    template <typename Fn>
+    static ggml_tensor* forward_token_chunks(ggml_context* ctx, ggml_tensor* x, int64_t chunk_size, Fn&& fn) {
+        if (chunk_size >= x->ne[1]) {
+            return fn(x);
+        }
+        std::vector<ggml_tensor*> chunks;
+        for (int64_t start = 0; start < x->ne[1]; start += chunk_size) {
+            auto input = ggml_ext_slice(ctx, x, 1, start, std::min(start + chunk_size, x->ne[1]), false);
+            if (!ggml_is_contiguous(input)) {
+                input = ggml_cont(ctx, input);
+            }
+            chunks.push_back(fn(input));
+        }
+        return ggml_ext_vec_concat(ctx, chunks, 1);
+    }
+
+    static std::shared_ptr<UnaryBlock> make_linear(int64_t in_features,
+                                                   int64_t out_features,
+                                                   int64_t rank,
+                                                   bool force_prec_f32 = false,
+                                                   float scale         = 1.f) {
+        if (rank > 0) {
+            return std::make_shared<LowRankLinear>(in_features, rank, out_features, force_prec_f32, scale);
+        }
+        return std::make_shared<Linear>(in_features, out_features, false, false, force_prec_f32, scale);
+    }
