+// Few-step checkpoints may store their default schedule; it is used whenever the request has no explicit
+// sigmas.
+void StableDiffusionGGML::load_model_sigmas() {
+    model_sigmas.clear();
+
+    std::vector<float> loaded;
+    if (!model_manager->load_float_tensor("model.diffusion_model.hyperflow_sigmas", loaded)) {
+        return;
+    }
+    bool valid = loaded.size() >= 2 && loaded.back() == 0.0f;
+    for (size_t i = 0; valid && i < loaded.size(); i++) {
+        valid = std::isfinite(loaded[i]) && loaded[i] >= 0.0f && loaded[i] <= 1.0f &&
+                (i == 0 || loaded[i] < loaded[i - 1]);
+    }
+    if (!valid) {
+        LOG_WARN("ignore invalid hyperflow_sigmas from model file");
+        return;
+    }
+
+    model_sigmas = std::move(loaded);
+    LOG_INFO("model file defines a %zu-step sampling schedule", model_sigmas.size() - 1);
+}
